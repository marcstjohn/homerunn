---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Logo from '../../components/Logo.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Blog — Homerunn" description="Marketing insights from Marc St. John. Real strategies, real numbers.">

  <!-- NAV -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-[#E5E5E5]">
    <div class="max-w-[1100px] mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/"><Logo /></a>
      <a
        href="/#contact"
        class="bg-[#D97706] hover:bg-[#B45309] text-white font-inter font-semibold text-sm px-5 py-2.5 rounded transition-colors"
      >
        Let's talk
      </a>
    </div>
  </header>

  <!-- HEADER -->
  <section class="bg-[#111111] pt-36 pb-20 px-6">
    <div class="max-w-[760px] mx-auto">
      <p class="font-inter text-[#D97706] font-semibold text-sm uppercase tracking-widest mb-4">Blog</p>
      <h1 class="font-sora font-bold text-5xl text-white leading-tight mb-4">
        What actually moves the needle.
      </h1>
      <p class="font-inter text-[#6B7280] text-lg">
        Real strategies. Real numbers. No fluff.
      </p>
    </div>
  </section>

  <!-- POSTS -->
  <section class="bg-white py-20 px-6">
    <div class="max-w-[760px] mx-auto">
      {posts.length === 0 ? (
        <p class="font-inter text-[#6B7280] text-lg">No posts yet. Check back soon.</p>
      ) : (
        <div class="divide-y divide-[#E5E5E5]">
          {posts.map((post) => (
            <article class="py-10">
              <time class="font-inter text-[#6B7280] text-sm">
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2 class="font-sora font-bold text-2xl text-[#111111] leading-tight mt-2 mb-3">
                <a href={`/blog/${post.id}`} class="hover:text-[#D97706] transition-colors">
                  {post.data.title}
                </a>
              </h2>
              <p class="font-inter text-[#6B7280] text-base leading-relaxed mb-4">
                {post.data.description}
              </p>
              <a
                href={`/blog/${post.id}`}
                class="font-inter font-semibold text-[#D97706] text-sm hover:text-[#B45309] transition-colors"
              >
                Read more &rarr;
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="bg-[#111111] border-t border-[#1F1F1F] py-8 px-6">
    <div class="max-w-[1100px] mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <a href="/"><Logo /></a>
      <p class="font-inter text-[#6B7280] text-sm">
        &copy; {new Date().getFullYear()} Homerunn. Columbus, OH.
      </p>
      <a href="/blog" class="font-inter text-[#6B7280] hover:text-white text-sm transition-colors">Blog</a>
    </div>
  </footer>

</Layout>
