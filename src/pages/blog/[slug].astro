---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 230));
---

<Layout title={`${post.data.title} — homerunn`} description={post.data.description}>

  <Header />

  <!-- ARTICLE HEADER -->
  <section class="bg-[#111111] diamond-texture pt-40 pb-20 px-6">
    <div class="relative max-w-[820px] mx-auto hero-in">
      <a href="/blog" class="arrow-link inline-flex items-center gap-2 font-inter text-[#A3A3A3] text-sm hover:text-white transition-colors mb-10"><span class="arrow rotate-180 inline-block">&rarr;</span> All posts</a>
      <p class="eyebrow mb-5">
        <time>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
        <span class="text-[#6B7280] mx-2">·</span><span class="text-[#A3A3A3]">{minutes} min read</span>
      </p>
      <h1 class="font-sora font-bold text-[clamp(2.2rem,4.6vw,3.5rem)] text-white leading-[1.08] tracking-[-0.022em] mb-6">
        {post.data.title}
      </h1>
      <p class="font-inter text-[#A3A3A3] text-lg md:text-xl leading-relaxed max-w-[700px]">{post.data.description}</p>
      <p class="font-inter text-sm text-[#8A8A8A] mt-10 pt-6 border-t border-[#262626]">By <span class="text-white font-medium">Marc St. John</span>, homerunn</p>
    </div>
  </section>

  <!-- ARTICLE BODY -->
  <section class="bg-white py-16 md:py-20 px-6">
    <div class="max-w-[720px] mx-auto prose-styles">
      <Content />
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#111111] diamond-texture py-20 px-6">
    <div class="relative max-w-[820px] mx-auto">
      <p class="eyebrow mb-4">Work with me</p>
      <h2 class="font-sora font-bold text-3xl md:text-4xl text-white leading-tight tracking-[-0.02em] mb-4">Ready to talk?</h2>
      <p class="font-inter text-[#A3A3A3] text-lg mb-8">If this resonated, let's see if it makes sense to work together.</p>
      <a
        href="/#contact"
        class="arrow-link inline-block bg-[#D97706] hover:bg-[#B45309] text-[#111111] font-inter font-semibold text-base px-8 py-4 rounded-[2px] transition-colors"
      >
        Get in touch <span class="arrow">&rarr;</span>
      </a>
    </div>
  </section>

  <Footer />

</Layout>

<style>
  .prose-styles :global(h2) {
    font-family: 'Sora', sans-serif;
    font-weight: 700;
    font-size: 1.75rem;
    color: #111111;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .prose-styles :global(p) {
    font-family: 'Inter', sans-serif;
    font-size: 1.125rem;
    color: #374151;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  /* Lede: first paragraph reads bigger, like an editorial deck */
  .prose-styles :global(> p:first-child) {
    font-size: 1.375rem;
    line-height: 1.7;
    color: #111111;
  }

  /* Section breaks as amber hairlines instead of gray rules */
  .prose-styles :global(hr) {
    border: none;
    height: 1px;
    background: linear-gradient(to right, rgba(217, 119, 6, 0.5), rgba(217, 119, 6, 0.08));
    margin: 3rem 0;
  }

  /* Pull quotes in big Sora */
  .prose-styles :global(blockquote) {
    border-left: 2px solid #D97706;
    padding-left: 1.5rem;
    margin: 2.5rem 0;
  }
  .prose-styles :global(blockquote p) {
    font-family: 'Sora', sans-serif;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.4;
    color: #111111;
  }

  .prose-styles :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose-styles :global(li) {
    font-family: 'Inter', sans-serif;
    font-size: 1.125rem;
    color: #374151;
    line-height: 1.8;
    margin-bottom: 0.5rem;
  }

  .prose-styles :global(strong) {
    font-weight: 600;
    color: #111111;
  }

  .prose-styles :global(a) {
    color: #D97706;
    text-decoration: none;
    font-weight: 600;
  }

  .prose-styles :global(a:hover) {
    color: #B45309;
  }
</style>
