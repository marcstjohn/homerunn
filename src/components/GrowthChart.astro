---
// Hero proof graphic. Two real, verified data points only:
// full-year 2020 revenue ($244,794) vs full-year 2025 ($2,703,472).
// The bars are drawn to true scale; the arc is the "home run" flight path,
// a brand device, not a data line. Nothing between the two years is plotted.
const BASE = 360;
const MAX_H = 238;
const v2020 = 244794;
const v2025 = 2703472;
const h2020 = Math.round((v2020 / v2025) * MAX_H * 10) / 10;
const h2025 = MAX_H;
---

<figure class="growth-chart relative" aria-labelledby="growth-chart-cap">
  <svg viewBox="0 0 520 430" class="w-full h-auto block" role="img" aria-label="Annual revenue grew from $245K in 2020 to $2.7M in 2025, more than 1,000%.">
    <!-- frame -->
    <rect x="0.5" y="0.5" width="519" height="429" rx="3" fill="#161616" stroke="#262626" />

    <!-- header -->
    <text x="32" y="46" class="gc-eyebrow">ANNUAL REVENUE</text>
    <text x="32" y="98" class="gc-big">+1,000%</text>
    <text x="32" y="124" class="gc-sub">2020 to 2025 · specialty ecommerce retailer</text>

    <!-- faint guides -->
    <g stroke="#232323" stroke-width="1">
      <line x1="32" y1={BASE - MAX_H} x2="488" y2={BASE - MAX_H} />
      <line x1="32" y1={BASE - MAX_H / 2} x2="488" y2={BASE - MAX_H / 2} />
    </g>
    <line x1="32" y1={BASE} x2="488" y2={BASE} stroke="#3A3A3A" stroke-width="1" />

    <!-- start marker: Oct 2021 -->
    <g class="gc-marker">
      <line x1="216" y1={BASE} x2="216" y2="302" stroke="#4B4B4B" stroke-width="1" stroke-dasharray="3 4" />
      <circle cx="216" cy="302" r="3" fill="#D97706" />
      <text x="226" y="306" class="gc-note">Oct 2021 · I start</text>
    </g>

    <!-- bars, true scale -->
    <rect class="gc-bar gc-bar-1" x="70" y={BASE - h2020} width="84" height={h2020} fill="#5C3A0E" />
    <rect class="gc-bar gc-bar-2" x="368" y={BASE - h2025} width="84" height={h2025} fill="#D97706" />

    <!-- the flight path -->
    <path class="gc-arc" d={`M152 ${BASE - h2020 - 4} Q 360 96 410 ${BASE - h2025 - 12}`} fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" />
    <circle class="gc-ball" cx="410" cy={BASE - h2025 - 12} r="5" fill="#FFFFFF" />

    <!-- values -->
    <text x="112" y={BASE - h2020 - 18} text-anchor="middle" class="gc-val gc-val-1">$245K</text>
    <text x="410" y={BASE - h2025 + 34} text-anchor="middle" class="gc-val gc-val-2">$2.7M</text>

    <!-- years -->
    <text x="112" y="388" text-anchor="middle" class="gc-year">2020</text>
    <text x="410" y="388" text-anchor="middle" class="gc-year">2025</text>

    <!-- span: this happened over five years, not overnight -->
    <g class="gc-span">
      <line x1="150" y1="384" x2="232" y2="384" stroke="#3A3A3A" stroke-width="1" />
      <line x1="290" y1="384" x2="372" y2="384" stroke="#3A3A3A" stroke-width="1" />
      <path d="M366 380 L372 384 L366 388" fill="none" stroke="#3A3A3A" stroke-width="1" />
      <text x="261" y="388" text-anchor="middle" class="gc-span-label">5 years</text>
    </g>
  </svg>
  <figcaption id="growth-chart-cap" class="font-inter text-[12.5px] text-[#6B7280] mt-3 leading-snug">
    Each bar is one year of sales, drawn to scale. 2020 is the last year before I started. Client anonymized.
  </figcaption>
</figure>

<style>
  .gc-eyebrow { font: 600 11px 'Inter', sans-serif; letter-spacing: .2em; fill: #D97706; }
  .gc-big { font: 700 46px 'Sora', sans-serif; letter-spacing: -.02em; fill: #FFFFFF; }
  .gc-sub { font: 400 13px 'Inter', sans-serif; fill: #8A8A8A; }
  .gc-note { font: 500 12px 'Inter', sans-serif; fill: #A3A3A3; }
  .gc-val { font: 700 22px 'Sora', sans-serif; letter-spacing: -.01em; }
  .gc-val-1 { fill: #D97706; }
  .gc-val-2 { fill: #111111; }
  .gc-year { font: 600 13px 'Inter', sans-serif; letter-spacing: .08em; fill: #8A8A8A; }
  .gc-span-label { font: 600 12px 'Inter', sans-serif; letter-spacing: .06em; fill: #D97706; }

  .gc-bar { transform-box: fill-box; transform-origin: 50% 100%; }

  @media (prefers-reduced-motion: no-preference) {
    .gc-bar-1 { animation: gc-grow .7s cubic-bezier(.2,.7,.3,1) .35s both; }
    .gc-bar-2 { animation: gc-grow 1.1s cubic-bezier(.2,.7,.3,1) .55s both; }
    .gc-arc {
      stroke-dasharray: 520;
      stroke-dashoffset: 520;
      animation: gc-draw 1.3s cubic-bezier(.45,.05,.3,1) 1.1s forwards;
    }
    .gc-ball { opacity: 0; animation: gc-fade .3s ease 2.3s forwards; }
    .gc-val-2 { opacity: 0; animation: gc-fade .4s ease 1.5s forwards; }
    .gc-marker { opacity: 0; animation: gc-fade .5s ease .9s forwards; }
  }
  @keyframes gc-grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes gc-draw { to { stroke-dashoffset: 0; } }
  @keyframes gc-fade { to { opacity: 1; } }
</style>
